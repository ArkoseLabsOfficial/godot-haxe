#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

import haxe_builders

Import("env")
Import("env_modules")

env_haxe = env_modules.Clone()

env_haxe.add_source_files(env.modules_sources, "*.cpp")

if env.editor_build:
    env_haxe.add_source_files(env.modules_sources, "./editor/*.cpp")

if env["tests"]:
    # The tests exercise behavior that is not compiled into a shipped template
    # (the packed metadata of an exported game is decided at compile time), so
    # the module tells the two apart with the same define the other modules use.
    env_haxe.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_haxe.add_source_files(env.modules_sources, "./tests/*.cpp")


# Pack the support files (generated bindings, Haxe runtime classes and the
# native glue compiled into every project library) into the engine binary, so
# that using Haxe requires nothing beyond the executable itself. Only the
# developer tooling in `dist/tools` is left out.
dist_dir = env.Dir("#modules/haxe/dist").abspath
if os.path.isdir(dist_dir):
    support_sources = []
    for root, dirs, files in os.walk(dist_dir):
        dirs[:] = sorted(directory for directory in dirs if directory not in ("tools", "__pycache__"))
        for name in sorted(files):
            support_sources.append(os.path.join(root, name))
    if support_sources:
        env_haxe.CommandNoCache(
            "#modules/haxe/haxe_support.gen.h",
            support_sources,
            env.Run(haxe_builders.make_haxe_support),
        )
